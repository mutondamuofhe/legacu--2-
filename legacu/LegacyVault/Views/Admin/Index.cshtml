@model IEnumerable<LegacyVault.Models.VerificationRequest>
@{ViewData["Title"]="Admin Verification";}<div class="page-heading"><div><span class="eyebrow">ADMINISTRATION</span><h1>Verification requests</h1><p>Review identity verification requests and record the decision.</p></div></div><section class="panel">@if(!Model.Any()){<div class="empty-state"><span>✓</span><p>No verification requests.</p></div>}else{foreach(var item in Model){<div class="asset-row"><span class="asset-badge">◉</span><div class="asset-info"><b>User ID @item.UserId</b><small>Requested @item.RequestedAt.ToLocalTime().ToString("MMM d, yyyy") · @item.Status</small></div><form asp-action="Review" method="post" class="admin-review"><input type="hidden" name="id" value="@item.Id" /><select name="status"><option>Approved</option><option>Rejected</option><option>Pending</option></select><input name="notes" placeholder="Optional note" /><button class="button button-primary">Save</button></form></div>}}</section>