@model IEnumerable<LegacyVault.Models.DigitalAsset>
@{ ViewData["Title"] = "Digital Assets"; }
<div class="page-heading"><div><span class="eyebrow">PRIVATE INVENTORY</span><h1>Digital assets</h1><p>Keep track of the accounts and services that matter to your legacy.</p></div><a class="button button-primary" asp-action="Create">+ Add asset</a></div>
<section class="panel table-panel"><div class="panel-title"><h2>Saved assets</h2><span class="count-pill">@Model.Count() shown</span></div><nav class="asset-filters" aria-label="Filter digital assets"><a class="@(string.IsNullOrEmpty((string?)ViewBag.SelectedCategory) ? "selected" : "")" asp-action="Index">All</a>@foreach (var category in (string[])ViewBag.Categories) { <a class="@((string?)ViewBag.SelectedCategory == category ? "selected" : "")" asp-action="Index" asp-route-category="@category">@category</a> }</nav>@if (!Model.Any()) { <div class="empty-state"><span>◈</span><p>No digital assets @(string.IsNullOrEmpty((string?)ViewBag.SelectedCategory) ? "yet" : "in this category").</p><a asp-action="Create">Add an asset</a></div> } else { <div class="asset-list">@foreach (var asset in Model) { <div class="asset-row"><span class="asset-badge">◈</span><div class="asset-info"><b>@asset.Name</b><small>@asset.Provider · @asset.Category</small></div><span class="release-tag">@(asset.ReleaseAfterVerification ? "Releases after verification" : "Private")</span><a class="text-link" asp-action="Edit" asp-route-id="@asset.Id">Edit</a><form asp-action="Delete" asp-route-id="@asset.Id" method="post"><button class="icon-button" title="Delete asset" type="submit">×</button></form></div>}</div> }</section>