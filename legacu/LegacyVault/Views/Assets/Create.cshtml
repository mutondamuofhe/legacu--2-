@model LegacyVault.Models.DigitalAsset
@{ ViewData["Title"] = "Add Digital Asset"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Back to assets</a><span class="eyebrow">NEW RECORD</span><h1>Add a digital asset</h1><p class="intro">Capture only what your trusted executor will need to identify and handle this account.</p><form asp-action="Create" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label asp-for="Name">Asset name<input asp-for="Name" placeholder="e.g. Personal email" /></label><label asp-for="Category">Category<input asp-for="Category" placeholder="e.g. Communication" /></label><label asp-for="Provider">Provider<input asp-for="Provider" placeholder="e.g. Proton Mail" /></label><label asp-for="AccountReference">Account reference<input asp-for="AccountReference" placeholder="Username or identifier" /></label></div><label asp-for="PreferredAction">Preferred action<textarea asp-for="PreferredAction" rows="4" placeholder="What should happen with this account?"></textarea></label><label class="toggle"><input asp-for="ReleaseAfterVerification" /><span>Release this information after verification</span></label><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button button-primary" type="submit">Save asset</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }