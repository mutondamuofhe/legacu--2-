@model LegacyVault.Models.DigitalAsset
@{ ViewData["Title"] = "Edit Digital Asset"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Back to assets</a><span class="eyebrow">UPDATE RECORD</span><h1>Edit digital asset</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label asp-for="Name">Asset name<input asp-for="Name" /></label><label asp-for="Category">Category<select asp-for="Category"><option value="">Choose a category</option><option>Banking</option><option>Social</option><option>Email</option><option>Entertainment</option><option>Shopping</option><option>Cloud Storage</option><option>Utilities</option><option>Other</option></select></label><label asp-for="Provider">Provider<input asp-for="Provider" /></label><label asp-for="AccountReference">Account reference<input asp-for="AccountReference" /></label><label asp-for="Credentials">Password or access secret<input asp-for="Credentials" type="password" autocomplete="new-password" placeholder="Leave blank to keep current secret" /></label></div><label asp-for="PreferredAction">Preferred action<textarea asp-for="PreferredAction" rows="4"></textarea></label><label class="toggle"><input asp-for="ReleaseAfterVerification" /><span>Release this information after verification</span></label><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button button-primary" type="submit">Save changes</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }