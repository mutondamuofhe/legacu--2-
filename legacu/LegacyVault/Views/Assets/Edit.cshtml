@model LegacyVault.Models.DigitalAsset
@{ ViewData["Title"] = "Edit Digital Asset"; }
<div class="form-page"><a class="back-link" asp-action="Index">← Back to assets</a><span class="eyebrow">UPDATE RECORD</span><h1>Edit digital asset</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label asp-for="Name">Asset name<input asp-for="Name" /></label><label asp-for="Category">Category<input asp-for="Category" /></label><label asp-for="Provider">Provider<input asp-for="Provider" /></label><label asp-for="AccountReference">Account reference<input asp-for="AccountReference" /></label></div><label asp-for="PreferredAction">Preferred action<textarea asp-for="PreferredAction" rows="4"></textarea></label><label class="toggle"><input asp-for="ReleaseAfterVerification" /><span>Release this information after verification</span></label><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button button-primary" type="submit">Save changes</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }