@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"><button class="sign-out" type="submit"><span class="nav-icon">↪</span><span>Sign Out</span></button></form>
}
else
{
    <a class="sign-out" asp-area="Identity" asp-page="/Account/Login"><span class="nav-icon">↪</span><span>Sign In</span></a>
}
