@model IEnumerable<LegacyVault.Models.VaultDocument>
@{ViewData["Title"]="Document Vault";}<div class="page-heading"><div><span class="eyebrow">PROTECTED FILES</span><h1>Document vault</h1><p>Keep important documents together and protected.</p></div><a class="button button-primary" asp-action="Create">+ Upload document</a></div><section class="panel">@if(!Model.Any()){<div class="empty-state"><span>▤</span><p>No documents uploaded yet.</p><a asp-action="Create">Upload your first document</a></div>}else{foreach(var item in Model){<div class="asset-row"><span class="asset-badge">▤</span><div class="asset-info"><b>@item.DisplayName</b><small>@((item.Size/1024.0).ToString("0.#")) KB · @item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</small></div><span class="release-tag">@(item.ReleaseAfterVerification?"Releases after verification":"Private")</span><a class="text-link" asp-action="Download" asp-route-id="@item.Id">Download</a><form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="icon-button">×</button></form></div>}}</section>