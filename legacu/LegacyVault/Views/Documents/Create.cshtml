@{ViewData["Title"]="Upload Document";}<div class="form-page"><a class="back-link" asp-action="Index">← Back to documents</a><span class="eyebrow">SECURE UPLOAD</span><h1>Upload a document</h1><form asp-action="Create" method="post" enctype="multipart/form-data" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><label for="file">Choose a file<input id="file" name="file" type="file" accept=".pdf,.docx,.txt,.png,.jpg,.jpeg" /></label><p class="muted">PDF, DOCX, TXT, PNG, or JPG up to 10 MB.</p><label class="toggle"><input name="releaseAfterVerification" type="checkbox" value="true" /><span>Release this document after verification</span></label><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button button-primary">Upload document</button></div></form></div>