@model IEnumerable<LegacyVault.Models.DigitalExecutor>
@{ViewData["Title"]="Executors";}<div class="page-heading"><div><span class="eyebrow">TRUSTED CONTACTS</span><h1>Digital executors</h1><p>Choose who should help carry out your wishes.</p></div><a class="button button-primary" asp-action="Create">+ Add executor</a></div><section class="panel table-panel">@if(!Model.Any()){<div class="empty-state"><span>♙</span><p>No executor assigned yet.</p><a asp-action="Create">Add a trusted contact</a></div>}else{foreach(var item in Model){<div class="asset-row"><span class="asset-badge">♙</span><div class="asset-info"><b>@item.Name</b><small>@item.Relationship · @item.Email</small></div><span class="release-tag">@(item.IsVerified?"Verified":"Pending")</span><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="icon-button" title="Delete executor">×</button></form></div>}}</section>