@model LegacyVault.Models.LegacyInstruction
@{ViewData["Title"]="Edit Instruction";}<div class="form-page"><a class="back-link" asp-action="Index">← Back to instructions</a><span class="eyebrow">UPDATE GUIDANCE</span><h1>Edit instruction</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Title">Title<input asp-for="Title" /></label><label asp-for="DigitalAssetId">Related asset<select asp-for="DigitalAssetId" asp-items="@(new SelectList(ViewBag.Assets, "Id", "Name"))"><option value="">General instruction</option></select></label><label asp-for="Details">Details<textarea asp-for="Details" rows="7"></textarea></label><label asp-for="PreferredAction">Preferred action<input asp-for="PreferredAction" /></label><label class="toggle"><input asp-for="ReleaseAfterVerification" /><span>Release this information after verification</span></label><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button button-primary">Save changes</button></div></form></div>