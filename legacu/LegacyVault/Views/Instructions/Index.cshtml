@model IEnumerable<LegacyVault.Models.LegacyInstruction>
@{ViewData["Title"]="Instructions";}<div class="page-heading"><div><span class="eyebrow">YOUR WISHES</span><h1>Instructions</h1><p>Leave clear, thoughtful guidance for the future.</p></div><a class="button button-primary" asp-action="Create">+ Add instruction</a></div><section class="panel">@if(!Model.Any()){<div class="empty-state"><span>≡</span><p>No instructions yet.</p><a asp-action="Create">Write your first instruction</a></div>}else{foreach(var item in Model){<div class="asset-row"><span class="asset-badge">≡</span><div class="asset-info"><b>@item.Title</b><small>@(item.DigitalAsset?.Name ?? "General guidance")</small></div><span class="release-tag">@(item.ReleaseAfterVerification?"Releases after verification":"Private")</span><a class="text-link" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="icon-button">×</button></form></div>}}</section>