@page
@model LegacyVault.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-card auth-card-register" aria-labelledby="register-title">
    <h1 id="register-title">Register</h1>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
        <label class="auth-field">
            <span class="visually-hidden">Full Name</span>
            <input asp-for="Input.FullName" placeholder="Full Name" autocomplete="name" />
            <span asp-validation-for="Input.FullName" class="auth-validation"></span>
        </label>
        <label class="auth-field">
            <span class="visually-hidden">ID Number</span>
            <input asp-for="Input.IdNumber" placeholder="ID Number" autocomplete="off" />
            <span asp-validation-for="Input.IdNumber" class="auth-validation"></span>
        </label>
        <label class="auth-field">
            <span class="visually-hidden">Email</span>
            <input asp-for="Input.Email" type="email" placeholder="Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="auth-validation"></span>
        </label>
        <label class="auth-field">
            <span class="visually-hidden">Phone Number</span>
            <input asp-for="Input.PhoneNumber" type="tel" placeholder="Phone Number" autocomplete="tel" />
            <span asp-validation-for="Input.PhoneNumber" class="auth-validation"></span>
        </label>
        <label class="auth-field">
            <span class="visually-hidden">Password</span>
            <input asp-for="Input.Password" placeholder="Password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="auth-validation"></span>
        </label>
        <button class="auth-submit" type="submit">Register</button>
    </form>
    <p class="auth-switch">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Login</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}