@page
@model LegacyVault.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-card" aria-labelledby="login-title">
    <h1 id="login-title">Login</h1>
    @if (TempData["RegistrationSuccess"] is string registrationSuccess)
    {
        <p class="auth-success" role="status">@registrationSuccess</p>
    }
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
        <label class="auth-field">
            <span class="visually-hidden">Email</span>
            <input asp-for="Input.Email" type="email" placeholder="Email" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="auth-validation"></span>
        </label>
        <label class="auth-field">
            <span class="visually-hidden">Password</span>
            <input asp-for="Input.Password" placeholder="Password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="auth-validation"></span>
        </label>
        <div class="auth-options">
            <label class="auth-remember"><input asp-for="Input.RememberMe" /> Remember me</label>
            <a asp-page="./ForgotPassword">Forgot Password?</a>
        </div>
        <button class="auth-submit" type="submit">Login</button>
    </form>
    <p class="auth-switch">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}